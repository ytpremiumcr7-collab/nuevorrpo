<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_PaymentApproval" targetNamespace="http://tuempresa.com/bpmn">

  <bpmn:message id="Msg_ComplianceRevoked" name="ComplianceRevokedMessage" />

  <bpmn:process id="paymentApprovalProcess" isExecutable="true"
                camunda:historyTimeToLive="1825">

    <bpmn:startEvent id="Start_Payment" camunda:initiator="initiator">
      <bpmn:outgoing>F_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F_P1" sourceRef="Start_Payment" targetRef="Sub_ComplianceGate" />

    <!-- Subproceso de compliance: boundary de revocación cancela el gate -->
    <bpmn:subProcess id="Sub_ComplianceGate">
      <bpmn:incoming>F_P1</bpmn:incoming>
      <bpmn:outgoing>F_P2</bpmn:outgoing>

      <bpmn:startEvent id="S_CG_Start"><bpmn:outgoing>F_CG1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sequenceFlow id="F_CG1" sourceRef="S_CG_Start" targetRef="Task_VerificarCompliance" />

      <bpmn:serviceTask id="Task_VerificarCompliance"
                        camunda:delegateExpression="${verificarComplianceDelegate}"
                        camunda:asyncBefore="true">
        <bpmn:incoming>F_CG1</bpmn:incoming>
        <bpmn:outgoing>F_CG2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="F_CG2" sourceRef="Task_VerificarCompliance" targetRef="S_CG_End" />
      <bpmn:endEvent id="S_CG_End"><bpmn:incoming>F_CG2</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>

    <!-- Boundary: revocación en vuelo cancela el subproceso -->
    <bpmn:boundaryEvent id="B_ComplianceRevoked" attachedToRef="Sub_ComplianceGate"
                        cancelActivity="true">
      <bpmn:outgoing>F_Blocked_Ext</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_ComplianceRevoked" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_Blocked_Ext" sourceRef="B_ComplianceRevoked" targetRef="End_Blocked_Ext" />
    <bpmn:endEvent id="End_Blocked_Ext"><bpmn:incoming>F_Blocked_Ext</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="F_P2" sourceRef="Sub_ComplianceGate" targetRef="GW_ComplianceDecision" />
    <bpmn:exclusiveGateway id="GW_ComplianceDecision" default="F_P2_Blocked">
      <bpmn:incoming>F_P2</bpmn:incoming>
      <bpmn:outgoing>F_P2_OK</bpmn:outgoing>
      <bpmn:outgoing>F_P2_Blocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_P2_OK" sourceRef="GW_ComplianceDecision" targetRef="Task_ThreeWayMatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_P2_Blocked" sourceRef="GW_ComplianceDecision" targetRef="End_ComplianceBlocked" />
    <bpmn:endEvent id="End_ComplianceBlocked"><bpmn:incoming>F_P2_Blocked</bpmn:incoming></bpmn:endEvent>

    <bpmn:serviceTask id="Task_ThreeWayMatch"
                      camunda:delegateExpression="${threeWayMatchDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>F_P2_OK</bpmn:incoming>
      <bpmn:outgoing>F_P3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F_P3" sourceRef="Task_ThreeWayMatch" targetRef="GW_Match" />

    <bpmn:exclusiveGateway id="GW_Match" default="F_Match_Fail">
      <bpmn:incoming>F_P3</bpmn:incoming>
      <bpmn:outgoing>F_Match_OK</bpmn:outgoing>
      <bpmn:outgoing>F_Match_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_Match_OK" sourceRef="GW_Match" targetRef="Task_EvaluatePaymentApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${matchResult != null &amp;&amp; matchResult.estado == 'MATCH' &amp;&amp; matchResult.matchId != null}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Match_Fail" sourceRef="GW_Match" targetRef="Task_ResolveComp" />

    <bpmn:userTask id="Task_ResolveComp" camunda:candidateGroups="FINANCE">
      <bpmn:incoming>F_Match_Fail</bpmn:incoming>
      <bpmn:outgoing>F_Match_Reviewed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_Match_Reviewed" sourceRef="Task_ResolveComp" targetRef="End_Match_Blocked" />
    <bpmn:endEvent id="End_Match_Blocked"><bpmn:incoming>F_Match_Reviewed</bpmn:incoming></bpmn:endEvent>

    <!-- Evaluate the approval policy before allowing any payment instruction. -->
    <bpmn:businessRuleTask id="Task_EvaluatePaymentApproval"
                           camunda:decisionRef="nivelAprobacionPago"
                           camunda:mapDecisionResult="singleResult"
                           camunda:resultVariable="approvalDecision"
                           camunda:asyncBefore="true">
      <bpmn:incoming>F_Match_OK</bpmn:incoming>
      <bpmn:outgoing>F_Approval_Evaluated</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="F_Approval_Evaluated" sourceRef="Task_EvaluatePaymentApproval" targetRef="GW_ApprovalPolicy" />

    <bpmn:exclusiveGateway id="GW_ApprovalPolicy" default="F_Approval_Manual">
      <bpmn:incoming>F_Approval_Evaluated</bpmn:incoming>
      <bpmn:outgoing>F_Approval_Auto</bpmn:outgoing>
      <bpmn:outgoing>F_Approval_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_Approval_Auto" sourceRef="GW_ApprovalPolicy" targetRef="Task_PersistPolicyApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalDecision != null &amp;&amp; approvalDecision.requiereRevisionManual == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- No human-approval API/evidence service exists yet. Stop safely; never create a payment. -->
    <bpmn:sequenceFlow id="F_Approval_Manual" sourceRef="GW_ApprovalPolicy" targetRef="End_ApprovalRequired" />
    <bpmn:endEvent id="End_ApprovalRequired"><bpmn:incoming>F_Approval_Manual</bpmn:incoming></bpmn:endEvent>

    <bpmn:serviceTask id="Task_PersistPolicyApproval"
                      camunda:delegateExpression="${persistAutomaticPaymentApprovalDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>F_Approval_Auto</bpmn:incoming>
      <bpmn:outgoing>F_Persist_Approval</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F_Persist_Approval" sourceRef="Task_PersistPolicyApproval" targetRef="Task_RegistrarPago" />

    <bpmn:serviceTask id="Task_RegistrarPago"
                      camunda:delegateExpression="${registrarPagoDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>F_Persist_Approval</bpmn:incoming>
      <bpmn:outgoing>F_P4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F_P4" sourceRef="Task_RegistrarPago" targetRef="End_Process_OK" />
    <bpmn:endEvent id="End_Process_OK"><bpmn:incoming>F_P4</bpmn:incoming></bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
