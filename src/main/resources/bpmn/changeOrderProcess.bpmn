<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_CO" targetNamespace="http://tuempresa.com/bpmn">
  <bpmn:process id="changeOrderProcess" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:startEvent id="Start_CO"><bpmn:outgoing>F_C1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F_C1" sourceRef="Start_CO" targetRef="Task_CalcImpact" />
    <bpmn:serviceTask id="Task_CalcImpact"
                      camunda:delegateExpression="${calcChangeOrderImpactDelegate}">
      <bpmn:incoming>F_C1</bpmn:incoming>
      <bpmn:outgoing>F_C2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F_C2" sourceRef="Task_CalcImpact" targetRef="Task_ApproveCO" />
    <bpmn:userTask id="Task_ApproveCO" camunda:candidateGroups="${changeOrderApprovalGroup}">
      <bpmn:incoming>F_C2</bpmn:incoming>
      <bpmn:outgoing>F_C3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_C3" sourceRef="Task_ApproveCO" targetRef="End_CO" />
    <bpmn:endEvent id="End_CO"><bpmn:incoming>F_C3</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
