# ============================================================
# Environment variables requeridas
# ============================================================

# EVIDENCE_HMAC_KEY: requerido por GenerateEvidenceManifestDelegate.
# En producción debe venir de KMS/Vault, NUNCA de un .env en disco.
# Este valor es solo para desarrollo; el código rechaza arrancar
# sin esta variable definida.
EVIDENCE_HMAC_KEY=REPLACE_WITH_RANDOM_SECRET_FROM_SECRET_MANAGER

# Base de datos (app_user: NOSUPERUSER NOBYPASSRLS)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/construction
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_APP_DB_PASSWORD
OUTBOX_DB_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_OUTBOX_WORKER_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# Solo el servicio migrator usa POSTGRES_PASSWORD para Flyway.
# El contenedor HTTP mantiene SPRING_FLYWAY_ENABLED=false y no recibe credenciales de migración.
CONSTRUCTION_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_BOOTSTRAP_TOKEN
ALLOW_X_USER_ID=false
OUTBOX_WORKER_ENABLED=true
OUTBOX_DATASOURCE_URL=jdbc:postgresql://localhost:5432/construction
OUTBOX_DATASOURCE_USERNAME=outbox_worker
OUTBOX_DATASOURCE_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_OUTBOX_WORKER_PASSWORD

# Perfil (dev | prod | test)
SPRING_PROFILES_ACTIVE=dev

# Actuator: métricas scrapeadas por la red interna; el perfil prod usa puerto de management separado.
